// Phase 31 unified durable receipt shared by Lead Ads, Instagram and Facebook Page webhooks.
enum MetaSocialWebhookProvider {
  META
}

enum MetaSocialWebhookPlatform {
  LEAD_ADS
  INSTAGRAM
  FACEBOOK_PAGE
}

enum MetaSocialWebhookReceiptState {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  BLOCKED
  FAILED
  DEAD_LETTERED
}

enum MetaSocialWebhookRetentionClass {
  STANDARD_WEBHOOK
  EXTENDED_FAILURE
  REPLAY_AUDIT
  SECURITY_REVIEW
}

enum MetaSocialWebhookReplayEligibility {
  NOT_ELIGIBLE
  APPROVAL_REQUIRED
  ELIGIBLE
  SOURCE_UNAVAILABLE
  SOURCE_EXPIRED
  UNKNOWN_OUTCOME_BLOCKED
}

enum MetaSocialWebhookReplaySourceType {
  NONE
  LEGACY_RECEIPT
  NORMALIZED_LEAD
  INSTAGRAM_MESSAGE
  DURABLE_JOB
}

model MetaSocialWebhookReceipt {
  id                  String                        @id @default(cuid())
  provider            MetaSocialWebhookProvider     @default(META)
  platform            MetaSocialWebhookPlatform
  environment         MetaPlatformEnvironment
  connectionKey       String
  providerDeliveryId  String?
  providerEventKey     String
  payloadDigest       String
  lastPayloadDigest   String
  digestMismatchCount Int                           @default(0)
  lastDigestMismatchAt DateTime?
  lastDigestMismatchCode String?
  safeMetadata        Json                          @default("{}")
  retentionClass      MetaSocialWebhookRetentionClass @default(STANDARD_WEBHOOK)
  retentionUntil      DateTime                      @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '30 days')"))
  dedupeRetainUntil   DateTime                      @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '365 days')"))
  metadataPrunedAt    DateTime?
  receivedAt          DateTime                      @default(now())
  firstSeenAt         DateTime                      @default(now())
  lastSeenAt          DateTime                      @default(now())
  duplicateCount      Int                           @default(0)
  state               MetaSocialWebhookReceiptState @default(RECEIVED)
  queueName           String?
  jobReference        String?
  attemptCount        Int                           @default(0)
  lastAttemptAt       DateTime?
  nextRetryAt         DateTime?
  failureCode         String?
  failureCategory     String?
  failureSummary      String?                       @db.Text
  deadLetteredAt      DateTime?
  leaseToken          String?
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  queuedAt            DateTime?
  processingStartedAt DateTime?
  processedAt         DateTime?
  blockedAt           DateTime?
  failedAt            DateTime?
  lastTransitionAt    DateTime?
  lastTransitionCode  String?
  lastTransitionActor String?
  stateVersion        Int                           @default(0)
  correlationId       String
  parentReceiptId     String?
  replayAttempt       Int                           @default(0)
  replayReason        String?
  replayRequestedBy   String?
  replayRequestedAt   DateTime?
  replayEligibility   MetaSocialWebhookReplayEligibility @default(NOT_ELIGIBLE)
  replaySourceType    MetaSocialWebhookReplaySourceType @default(NONE)
  replaySourceId      String?
  replaySourceExpiresAt DateTime?
  replayApprovalId    String?
  replayApprovedBy    String?
  replayApprovedAt    DateTime?
  replayApprovalReference String?
  replayCompletedAt   DateTime?
  replayResultCode    String?
  legacyReceiptType   String?
  legacyReceiptId     String?
  primaryIdentityReferenceId String?
  normalizedLeadId    String?
  instagramMessageId String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  parentReceipt MetaSocialWebhookReceipt?  @relation("MetaSocialWebhookReplay", fields: [parentReceiptId], references: [id], onDelete: SetNull)
  replayReceipts MetaSocialWebhookReceipt[] @relation("MetaSocialWebhookReplay")
  primaryIdentityReference MetaExternalReference? @relation("MetaSocialWebhookPrimaryIdentity", fields: [primaryIdentityReferenceId], references: [id], onDelete: SetNull)
  normalizedLead          MetaLead?                  @relation("MetaSocialWebhookNormalizedLead", fields: [normalizedLeadId], references: [id], onDelete: SetNull)
  instagramMessage        MetaMessage?               @relation("MetaSocialWebhookInstagramMessage", fields: [instagramMessageId], references: [id], onDelete: SetNull)
  leadProcessingAttempt   MetaLeadProcessingAttempt?
  leadDuplicates          MetaLeadDuplicate[]        @relation("MetaLeadDuplicateCanonicalReceipt")
  replayApproval          MetaAdminApproval?          @relation("MetaSocialWebhookReplayApproval", fields: [replayApprovalId], references: [id], onDelete: SetNull)

  @@unique([provider, platform, environment, connectionKey, providerEventKey], map: "MetaSocialWebhookReceipt_dedupe_scope_key")
  @@index([state, nextRetryAt], map: "MetaSocialWebhookReceipt_state_retry_idx")
  @@index([state, leaseExpiresAt], map: "MetaSocialWebhookReceipt_state_lease_idx")
  @@index([platform, receivedAt], map: "MetaSocialWebhookReceipt_platform_received_idx")
  @@index([environment, connectionKey, receivedAt], map: "MetaSocialWebhookReceipt_connection_received_idx")
  @@index([correlationId], map: "MetaSocialWebhookReceipt_correlation_idx")
  @@index([providerDeliveryId], map: "MetaSocialWebhookReceipt_delivery_idx")
  @@index([parentReceiptId], map: "MetaSocialWebhookReceipt_parent_idx")
  @@index([retentionClass, retentionUntil], map: "MetaSocialWebhookReceipt_retention_idx")
  @@index([dedupeRetainUntil], map: "MetaSocialWebhookReceipt_dedupe_retention_idx")
  @@index([replayEligibility, replaySourceExpiresAt], map: "MetaSocialWebhookReceipt_replay_eligibility_idx")
  @@index([replayApprovalId], map: "MetaSocialWebhookReceipt_replay_approval_idx")
  @@index([legacyReceiptType, legacyReceiptId], map: "MetaSocialWebhookReceipt_legacy_idx")
  @@index([primaryIdentityReferenceId], map: "MetaSocialWebhookReceipt_primary_identity_idx")
  @@index([normalizedLeadId], map: "MetaSocialWebhookReceipt_normalized_lead_idx")
  @@index([instagramMessageId], map: "MetaSocialWebhookReceipt_instagram_message_idx")
}

model MetaLead {
  id                    String                  @id @default(cuid())
  leadgenId             String                  @unique
  provider              MetaSocialWebhookProvider @default(META)
  environment           MetaPlatformEnvironment?
  connectionKey         String?
  pageIdentityReferenceId String?
  formIdentityReferenceId String?
  formId                String?
  pageId                String?
