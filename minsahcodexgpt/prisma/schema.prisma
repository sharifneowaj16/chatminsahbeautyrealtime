  rawFields             Json
  rawPayloadEncrypted   String?                 @db.Text
  rawPayloadDigest      String?
  normalizedData        Json?
  normalizedPhoneHash   String?
  normalizedEmailHash   String?
  phoneFingerprint      String?
  emailFingerprint      String?
  fingerprintVersion    String?
  phoneMasked           String?
  emailMasked           String?
  fullName              String?
  city                  String?
  area                  String?
  productInterest       String?
  isTestLead            Boolean?
  status                MetaLeadStatus          @default(NEW)
