// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Minsah Beauty - Prisma Schema
// PostgreSQL Database for Dokploy Deployment

// ==========================================
// User & Authentication Models
// ==========================================

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerified   DateTime?
  passwordHash    String?
  firstName       String?
  lastName        String?
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  avatar          String?
  phoneVerified   Boolean    @default(false)
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  loyaltyPoints   Int        @default(0)
  referralCode    String?    @unique
  referredById    String?
  referredBy      User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]     @relation("Referrals")

  newsletter          Boolean @default(true)
  smsNotifications    Boolean @default(false)
  promotions          Boolean @default(true)
  newProducts         Boolean @default(true)
  orderUpdates        Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  accounts            Account[]
  sessions            Session[]
  addresses           Address[]
  orders              Order[]
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]
  reviews             Review[]
  refreshTokens       RefreshToken[]
  customerBehavior    CustomerBehavior?
  searchHistory       SearchHistory?
  campaignAttribution CampaignAttribution?
  trackingDevice      TrackingDevice?
  returns             Return[]
  searchClicks        SearchClickEvent[]
  giftsSent           GiftRequest[]       @relation("GiftSender")
  giftsReceived       GiftRequest[]       @relation("GiftRecipient")

  @@index([email])
  @@index([referralCode])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@index([email])
  @@index([token])
}

// ==========================================
// Admin Models
// ==========================================

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  avatar       String?
  role         AdminRole  @default(STAFF)
  status       UserStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  refreshTokens      AdminRefreshToken[]
  shortlistItems     InventoryShortlist[]
  purchaseShortlist  PurchaseShortlist[]
  assignedMetaLeads  MetaLead[] @relation("MetaLeadAssignee")
  metaLeadContactAttempts MetaLeadContactAttempt[]
  metaLeadAssignmentRules MetaLeadAssignmentRule[]
  metaLeadAgentProfile MetaLeadAgentProfile?
  metaAdminApprovalsRequested MetaAdminApproval[] @relation("MetaAdminApprovalRequester")
  metaAdminApprovalsApproved  MetaAdminApproval[] @relation("MetaAdminApprovalApprover")
  metaAdminApprovalsRejected  MetaAdminApproval[] @relation("MetaAdminApprovalRejector")
  metaAdminAudits             MetaAdminAudit[]    @relation("MetaAdminAuditActor")
  metaIncidentsAcknowledged   MetaIncident[]      @relation("MetaIncidentAcknowledgedBy")
  metaIncidentsResolved       MetaIncident[]      @relation("MetaIncidentResolvedBy")

  @@index([email])
}

model AdminRefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
}

// ==========================================
// Address Model
// ==========================================

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  firstName  String
  lastName   String
  company    String?
  street1    String
  street2    String?
  city       String
  state      String
  postalCode String
  country    String      @default("Bangladesh")
  phone      String?
  pathaoCityId Int?
  pathaoZoneId Int?
  pathaoAreaId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ==========================================
// Product Models
// ==========================================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  website     String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?  @db.Text
  paymentTerms  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([code])
  @@index([name])
  @@index([isActive])
}

enum ProductAvailabilityMode {
  STANDARD
  PREORDER
  DISCONTINUED
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

model Product {
  id               String   @id @default(cuid())
  sku              String   @unique
  name             String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2)
  costPrice        Decimal? @db.Decimal(10, 2)

  // Inventory
  quantity          Int     @default(0)
  reservedQuantity  Int     @default(0)
  lowStockThreshold Int     @default(5)
  trackInventory    Boolean @default(true)
  allowBackorder    Boolean @default(false)

  // Physical attributes
  weight Decimal? @db.Decimal(10, 3)
  length Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)

  // Status
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  isNew      Boolean @default(false)

  // SEO
  metaTitle          String?
  metaDescription    String?
  metaKeywords       String?
  bengaliName        String?
  bengaliDescription String? @db.Text
  focusKeyword         String?
  secondaryKeywords    String[] @default([])
  bengaliFocusKeyword  String?
  bengaliSecondaryKeywords String[] @default([])
  ogDescription        String?
  ogTitle              String?
  ogImageUrl           String?
  canonicalUrl         String?

  // Full SEO rendering fields for product pages
  pageH1                    String?
  seoIntro                  String?  @db.Text
  faqSchemaNote             String?  @db.Text
  authenticityNote          String?  @db.Text
  ingredientVerificationStatus String?
  seoValidationChecklist    String[] @default([])

  // JSON-LD / technical SEO payloads
  structuredDataJsonLd      Json?
  productGroupJsonLd        Json?
  merchantListingJsonLd     Json?
  breadcrumbJsonLd          Json?
  sitemapIndexing           Json?
  variantUrlStrategy        Json?

  // Extended SEO & semantic search fields
  searchIntent         String?
  targetAudience       String?  @db.Text
  primaryConcern       String?
  keyBenefits          String[] @default([])
  buyingIntentKeywords String[] @default([])
  searchTags           String[] @default([])
  synonyms             String[] @default([])
  banglaSearchTerms    String[] @default([])
  reviewKeywords       String[] @default([])
  entities             String[] @default([])

  // Product page structured content
  descriptionSections  Json?
  productSpecs         Json?
  productAttributes    Json?
  shadeOptions         Json?
  variantPriceTable    Json?
  variantComparisonTable Json?
  internalLinks        Json?
  usageInstructions    String[] @default([])
  imageAltTexts        String[] @default([])
  faqSchemaReady       Boolean  @default(false)
  gender               String?

  // Beauty & Product Specs
  subcategory   String?
  skinType      String[]
  ingredients   String?   @db.Text
  shelfLife     String?
  expiryDate    DateTime?
  originCountry String?   @default("Bangladesh (Local)")

  // Shipping
  shippingWeight String?
  isFragile      Boolean @default(false)

  // Delivery Offers
  // Customer-facing delivery campaign fields. Actual courier cost stays separate on Order.
  deliveryOfferEnabled   Boolean           @default(false)
  deliveryOfferType      DeliveryOfferType @default(DEFAULT)
  deliveryOfferAmount    Decimal?          @db.Decimal(10, 2)
  deliveryOfferStartDate DateTime?
  deliveryOfferEndDate   DateTime?
  deliveryOfferBadgeText String?

  // Discount & Offers
  discountPercentage Decimal?  @db.Decimal(5, 2)
  salePrice          Decimal?  @db.Decimal(10, 2)
  offerStartDate     DateTime?
  offerEndDate       DateTime?
  flashSaleEligible  Boolean   @default(false)

  // Commerce Options
  returnEligible  Boolean @default(true)
  codAvailable    Boolean @default(true)
  preOrderOption  Boolean @default(false)
  barcode         String?
  relatedProducts String?

  // Structured Data
  condition              ProductCondition        @default(NEW)
  availabilityMode       ProductAvailabilityMode @default(STANDARD)
  preorderAvailableOn    DateTime?
  gtin                   String?
  mpn                    String?
  googleProductCategory  String?
  facebookProductCategory String?
  averageRating Decimal? @db.Decimal(3, 2)
  reviewCount   Int      @default(0)
  faqs          Json?

  // Tracking & product analytics counters
  viewCount                 Int     @default(0)
  uniqueViewCount           Int     @default(0)
  addToCartCount            Int     @default(0)
  viewCartCount             Int     @default(0)
  checkoutStartCount        Int     @default(0)
  checkoutShippingInfoCount Int     @default(0)
  checkoutPaymentInfoCount  Int     @default(0)
  orderCount          Int     @default(0)
  confirmedOrderCount Int     @default(0)
  deliveredOrderCount Int     @default(0)
  cancelledOrderCount Int     @default(0)
  returnedOrderCount  Int     @default(0)
  refundedOrderCount  Int     @default(0)
  analyticsRevenue    Decimal @default(0) @db.Decimal(12, 2)

  // Relations
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  images             ProductImage[]
  variants           ProductVariant[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  searchClicks       SearchClickEvent[]
  searchMetrics      SearchClickMetrics[]
  productDailyMetrics ProductDailyMetric[]
  productViewDedups  ProductViewDedup[]
  giftRequests       GiftRequest[]
  supplierLinks      SupplierProduct[]
  purchaseItems      PurchaseOrderItem[]
  shortlistItems     InventoryShortlist[]
  purchaseShortlist  PurchaseShortlist[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([deletedAt])
  @@index([isActive, isFeatured])
  @@index([isActive, deletedAt])
  @@index([canonicalUrl])
  @@index([viewCount])
  @@index([addToCartCount])
  @@index([viewCartCount])
  @@index([checkoutStartCount])
  @@index([checkoutShippingInfoCount])
  @@index([checkoutPaymentInfoCount])
  @@index([orderCount])
  @@index([deliveredOrderCount])
  @@index([refundedOrderCount])
  @@index([deliveryOfferEnabled])
  @@index([deliveryOfferType])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  title     String?
  sortOrder Int     @default(0)
  isDefault Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  name              String
  price             Decimal? @db.Decimal(10, 2)
  salePrice         Decimal? @db.Decimal(10, 2)
  offerStartDate    DateTime?
  offerEndDate      DateTime?
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  allowBackorder    Boolean?
  isActive          Boolean  @default(true)
  deletedAt         DateTime?
  availabilityMode  ProductAvailabilityMode?
  preorderAvailableOn DateTime?
  condition         ProductCondition?
  gtin              String?
  mpn               String?
  barcode           String?
  attributes        Json?
  image             String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive, deletedAt])
}

model ProductDailyMetric {
  id                  String   @id @default(cuid())
  productId           String
  metricDate          DateTime

  views               Int      @default(0)
  uniqueViews         Int      @default(0)
  addToCarts          Int      @default(0)
  viewCarts           Int      @default(0)
  checkoutStarts      Int      @default(0)
  checkoutShippingInfos Int    @default(0)
  checkoutPaymentInfos  Int    @default(0)
  orders              Int      @default(0)
  confirmedOrders     Int      @default(0)
  deliveredOrders     Int      @default(0)
  cancelledOrders     Int      @default(0)
  returnedOrders      Int      @default(0)

  revenue             Decimal  @default(0) @db.Decimal(12, 2)
  confirmedRevenue    Decimal  @default(0) @db.Decimal(12, 2)
  deliveredRevenue    Decimal  @default(0) @db.Decimal(12, 2)
  cancelledRevenue    Decimal  @default(0) @db.Decimal(12, 2)
  returnedRevenue     Decimal  @default(0) @db.Decimal(12, 2)
  refundedOrders      Int      @default(0)
  refundedRevenue     Decimal  @default(0) @db.Decimal(12, 2)
  estimatedProfit     Decimal? @db.Decimal(12, 2)

  addToCartRate       Decimal? @db.Decimal(7, 4)
  checkoutRate        Decimal? @db.Decimal(7, 4)
  purchaseRate        Decimal? @db.Decimal(7, 4)
  confirmationRate    Decimal? @db.Decimal(7, 4)
  deliveryRate        Decimal? @db.Decimal(7, 4)
  returnRate          Decimal? @db.Decimal(7, 4)

  grade               String?
  notes               String?  @db.Text

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, metricDate])
  @@index([metricDate])
  @@index([grade])
}

model ProductViewDedup {
  id             String   @id @default(cuid())
  productId      String
  visitorKeyHash String
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, visitorKeyHash])
  @@index([expiresAt])
  @@index([productId])
}

model SupplierProduct {
  id                     String    @id @default(cuid())
  supplierId             String
  productId              String
  supplierSku            String?
  lastPurchaseRate       Decimal?  @db.Decimal(10, 2)
  lowestPurchaseRate     Decimal?  @db.Decimal(10, 2)
  lowestPurchaseRateDate DateTime?
  lastPurchasedAt        DateTime?
  isPreferred            Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@index([isPreferred])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  orderNumber  String    @unique
  supplierId   String
  status       String    @default("DRAFT")
  notes        String?   @db.Text
  subtotal     Decimal   @default(0) @db.Decimal(10, 2)
  shippingCost Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount    Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount  Decimal   @default(0) @db.Decimal(10, 2)
  orderedAt    DateTime  @default(now())
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([orderedAt])
}

model PurchaseOrderItem {
  id               String    @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Int
  receivedQuantity Int       @default(0)
  unitCost         Decimal   @db.Decimal(10, 2)
  notes            String?   @db.Text
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([receivedAt])
}

model InventoryShortlist {
  id        String    @id @default(cuid())
  adminId   String?
  productId String    @unique
  note      String?   @db.Text
  priority  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  admin   AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([priority])
}

// ==========================================
// Purchase Shortlist Model
// ==========================================

model PurchaseShortlist {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  quantity    Int
  buyPrice    Decimal  @db.Decimal(10, 2)
  sellPrice   Decimal  @db.Decimal(10, 2)

  purchased   Boolean  @default(false)
  purchasedAt DateTime?
  priority    String   @default("NORMAL")
  notes       String?  @db.Text

  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@index([adminId])
  @@index([purchased])
  @@index([priority])
}

// ==========================================
// Unlisted Products (Custom Products from Orders)
// ==========================================

model UnlistedProduct {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  costPrice   Decimal? @db.Decimal(10, 2)
  description String?  @db.Text
  image       String?
  usageCount  Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([sku])
  @@index([lastUsedAt])
}

// ==========================================
// Cart Models
// ==========================================

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  productId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ==========================================
// Order Models
// ==========================================

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  subtotal       Decimal @db.Decimal(10, 2)
  // Customer-facing delivery charge. For free-delivery offers this remains 0.
  shippingCost   Decimal @default(0) @db.Decimal(10, 2)
  // Internal courier/accounting fields. These must not overwrite customer totals after order creation.
  courierDeliveryCharge  Decimal?              @db.Decimal(10, 2)
  deliveryDiscountAmount Decimal               @default(0) @db.Decimal(10, 2)
  deliveryPricingSource  DeliveryPricingSource @default(DEFAULT)
  deliveryOfferType      DeliveryOfferType     @default(DEFAULT)
  deliveryOfferProductId String?
  deliveryOfferBadgeText String?

  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  addressId       String?
  shippingAddress Address? @relation(fields: [addressId], references: [id])
  shippingMethod  String?
  trackingNumber  String?

  steadfastConsignmentId String?
  steadfastTrackingCode  String?
  steadfastStatus        String?
  pathaoStatus           String?
  steadfastSentAt        DateTime?
  pathaoConsignmentId    String?
  pathaoTrackingCode     String?
  pathaoSentAt           DateTime?
  pathaoResponse         Json?

  couponCode     String?
  couponDiscount Decimal? @db.Decimal(10, 2)

  // Checkout duplicate-submission protection. Same user + key returns the existing
  // order when the payload hash matches, and rejects conflicting payload reuse.
  checkoutIdempotencyKey String?
  checkoutPayloadHash    String?

  // Online payment lifecycle/reservation guard. Online payment orders reserve stock
  // briefly, become CONFIRMED only after verified payment, and can expire safely.
  paymentExpiresAt DateTime?
  stockReservedAt  DateTime?
  stockFinalizedAt DateTime?
  stockReleasedAt  DateTime?
  adminNotifiedAt  DateTime?

  customerNote String?
  adminNote    String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  isGiftOrder  Boolean @default(false)
  giftToken    String?

  // Facebook / Meta CAPI data — save at checkout
  fbp                  String?
  fbc                  String?
  externalId           String?
  anonymousVisitorId   String?
  customerIp           String?
  customerUa           String?

  // GA4 / Measurement Protocol data
  gaClientId           String?
  gaSessionId          String?
  gaPurchaseSent       Boolean   @default(false)
  gaPurchaseSentAt     DateTime?
  gaPurchaseProcessingAt DateTime?
  gaRefundSent         Boolean   @default(false)
  gaRefundSentAt       DateTime?

  // TikTok attribution / future Events API Purchase data
  tiktokClickId              String?
  tiktokTtp                  String?
  tiktokExternalId           String?
  tiktokEventId              String?
  tiktokPurchaseSent         Boolean   @default(false)
  tiktokPurchaseSentAt       DateTime?
  tiktokPurchaseProcessingAt DateTime?

  // Meta Purchase tracking / idempotency
  metaPurchaseSent     Boolean   @default(false)
  metaPurchaseSentAt   DateTime?
  metaPurchaseProcessingAt  DateTime?
  metaBrowserPurchaseClaimedAt DateTime?   // DB-level guard: signed browser purchase flow was authorized/claimed; not guaranteed Pixel delivery
  metaEventId          String?
  metaEventOutbox      MetaEventOutbox[]

  // UTM / Ad attribution
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  campaignId           String?
  adsetId              String?
  adId                 String?
  placement            String?

  // Landing / creative / A-B test attribution
  firstLandingPath     String?
  firstLandingUrl      String?
  referrer             String?
  offerVersion         String?
  abVariant            String?
  landingOffer         String?
  attributionCouponCode String?
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  campaignSourceUrl    String?

  // COD / payment / return timestamps
  phoneConfirmedAt     DateTime?
  paymentPaidAt        DateTime?
  returnedAt           DateTime?
  refundedAt           DateTime?

  // Test/internal order flag
  isTest               Boolean   @default(false)

  // Generic courier reconciliation
  courierName          String?
  courierConsignmentId String?
  courierStatus        String?
  courierDeliveredAt   DateTime?
  courierReturnedAt    DateTime?

  // Phone confirmation quality
  confirmationStatus   String?
  confirmationNote     String?   @db.Text
  confirmedByAdminId   String?

  // Tracking consent / privacy filters
  trackingConsent       String?  @default("unknown")
  trackingConsentVersion String?
  trackingPolicyReason   String?
  nonEssentialTrackingAllowed Boolean @default(false)
  trackingFilteredReason String?

  // Tracking debug/version
  trackingSchemaVersion String?  @default("mb_tracking_v1")

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  returns  Return[]
  notifications AdminNotification[]
  steadfastWebhookEvents SteadfastWebhookEvent[]
  pathaoWebhookEvents    PathaoWebhookEvent[]
  purchaseShortlist      PurchaseShortlist[]
  metaCapiFailures       MetaCapiFailure[]
  convertedMetaLeads     MetaLead[] @relation("MetaLeadConvertedOrder")

  @@unique([userId, checkoutIdempotencyKey])
  @@index([userId])
  @@index([checkoutIdempotencyKey])
  @@index([paymentExpiresAt])
  @@index([stockFinalizedAt])
  @@index([stockReleasedAt])
  @@index([adminNotifiedAt])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([steadfastConsignmentId])
  @@index([steadfastTrackingCode])
  @@index([pathaoConsignmentId])
  @@index([pathaoTrackingCode])
  @@index([isGiftOrder])
  @@index([giftToken])
  @@index([fbp])
  @@index([fbc])
  @@index([externalId])
  @@index([anonymousVisitorId])
  @@index([gaClientId])
  @@index([gaPurchaseSent])
  @@index([gaPurchaseProcessingAt])
  @@index([tiktokClickId])
  @@index([tiktokEventId])
  @@index([tiktokPurchaseSent])
  @@index([tiktokPurchaseProcessingAt])
  @@index([metaPurchaseSent])
  @@index([metaPurchaseProcessingAt])
  @@index([metaBrowserPurchaseClaimedAt])
  @@index([metaEventId])
  @@index([utmSource])
  @@index([utmTerm])
  @@index([campaignId])
  @@index([adsetId])
  @@index([adId])
  @@index([offerVersion])
  @@index([abVariant])
  @@index([attributionCouponCode])
  @@index([phoneConfirmedAt])
  @@index([paymentPaidAt])
  @@index([returnedAt])
  @@index([refundedAt])
  @@index([isTest])
  @@index([courierConsignmentId])
  @@index([deliveryPricingSource])
  @@index([deliveryOfferProductId])
  @@index([confirmationStatus])
  @@index([trackingConsent])
  @@index([nonEssentialTrackingAllowed])
}

model PathaoWebhookEvent {
