  schemaVersion     String?  @default("mb_tracking_v1")

  statusCode        Int?
  errorCode         String?
  errorSubcode      String?
  errorMessage      String?  @db.Text

  retryCount        Int      @default(0)
  finalFailed       Boolean  @default(false)
  failureCategory   String   @default("DEBUG_NON_CRITICAL")
  lastRetryAt       DateTime?
  resolvedAt        DateTime?
  cleanupAfter      DateTime?

  hasFbp            Boolean  @default(false)
  hasFbc            Boolean  @default(false)
  hasExternalId     Boolean  @default(false)
  hasEmailHash      Boolean  @default(false)
  hasPhoneHash      Boolean  @default(false)
  hasIp             Boolean  @default(false)
  hasUa             Boolean  @default(false)

  safePayload       Json?
  responsePayload   Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([eventName])
  @@index([eventId])
  @@index([provider])
  @@index([statusCode])
  @@index([errorCode])
  @@index([finalFailed])
  @@index([failureCategory])
  @@index([cleanupAfter])
  @@index([resolvedAt])
  @@index([createdAt])
}


model ShopTrackingEvent {
