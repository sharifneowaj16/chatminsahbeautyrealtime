  reconciliations MetaReconciliation[]

  @@unique([workflowId, stepKey], map: "MetaWorkflowStep_workflow_key")
  @@unique([workflowId, ordinal], map: "MetaWorkflowStep_workflow_ordinal_key")
  @@index([workflowId, status, ordinal], map: "MetaWorkflowStep_status_idx")
}

model MetaProviderJob {
  id                 String                @id @default(uuid())
  workflowId         String
  workflow           MetaWorkflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId             String
  step               MetaWorkflowStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  purpose            MetaProviderJobPurpose @default(EXECUTION)
  capability         String
  operationType      String
  requestFingerprint String
  providerJobType    String?
  providerJobId      String?
  providerObjectId   String?
  status             MetaProviderJobStatus @default(PENDING)
  requestState       Json?
  responseState      Json?
  beforeState        Json?
  afterState         Json?
  unknownSince       DateTime?
  lastCheckedAt      DateTime?
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  reconciliation     MetaReconciliation?

  @@unique([stepId, purpose, requestFingerprint], map: "MetaProviderJob_step_purpose_fingerprint_key")
  @@index([workflowId, stepId, status], map: "MetaProviderJob_workflow_step_status_idx")
  @@index([capability, operationType, requestFingerprint], map: "MetaProviderJob_fingerprint_idx")
  @@index([providerJobId], map: "MetaProviderJob_provider_job_idx")
  @@index([providerObjectId], map: "MetaProviderJob_provider_object_idx")
}

model MetaReconciliation {
  id             String                   @id @default(uuid())
  operationId    String
  operation      MetaOperation            @relation(fields: [operationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       MetaWorkflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId         String
  step           MetaWorkflowStep         @relation(fields: [stepId], references: [id], onDelete: Cascade)
  providerJobId  String                   @unique
  providerJob    MetaProviderJob          @relation(fields: [providerJobId], references: [id], onDelete: Cascade)
  capability     String
  operationType  String
  resolverKey    String
  status         MetaReconciliationStatus @default(PENDING)
  attempts       Int                      @default(0)
  nextCheckAt    DateTime                 @default(now())
  expiresAt      DateTime
  evidence       Json?
  resolution     Json?
  lastError      Json?
  version        Int                      @default(1)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, nextCheckAt], map: "MetaReconciliation_due_idx")
  @@index([workflowId, status], map: "MetaReconciliation_workflow_status_idx")
  @@index([expiresAt], map: "MetaReconciliation_expiry_idx")
}

model MetaReplay {
  id                String           @id @default(uuid())
  sourceOperationId String
  sourceOperation   MetaOperation    @relation("MetaReplaySource", fields: [sourceOperationId], references: [id], onDelete: Restrict)
  replayOperationId String?          @unique
  replayOperation   MetaOperation?   @relation("MetaReplayTarget", fields: [replayOperationId], references: [id], onDelete: SetNull)
  requestedBy       String
  approvedBy        String?
  approvalRole      String?
  reason            String
  idempotencyKey    String           @unique
  requestDigest     String
  expiresAt         DateTime
  approvedAt        DateTime?
  status            MetaReplayStatus @default(REQUESTED)
  rejectionCode     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([sourceOperationId, createdAt], map: "MetaReplay_source_created_idx")
  @@index([status, createdAt], map: "MetaReplay_status_created_idx")
}

model MetaWorkflowLock {
  scopeKey      String   @id
  ownerId       String
  leaseToken    String   @unique
  fencingToken  BigInt   @default(0)
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  @@index([expiresAt], map: "MetaWorkflowLock_expiry_idx")
}

model MetaConnectionCheck {
  id                  String               @id @default(cuid())
  connectionId        String
  connection          MetaConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status              MetaConnectionStatus
  tokenValid          Boolean?
  tokenExpiresAt      DateTime?
  dataAccessExpiresAt DateTime?
  appIdMatches        Boolean?
  permissions         Json?
  assets              Json?
  versionPolicy       Json?
  warnings            Json?
  safeError           Json?
  checkedAt           DateTime             @default(now())

  @@index([connectionId, checkedAt])
  @@index([status, checkedAt])
}

// ==========================================
// Meta Admin Operations / Approval / Audit
// ==========================================

enum MetaAdminActionRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MetaAdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTING
  EXECUTED
  FAILED
  EXPIRED
  CANCELLED
}

enum MetaAdminAuditOutcome {
  SUCCEEDED
  FAILED
  DENIED
}

model MetaAdminApproval {
  id                 String                  @id @default(cuid())
  actionKey          String
  risk               MetaAdminActionRisk
  resourceType       String
  resourceId         String?
  payloadHash        String
  payload            Json
  reason             String                  @db.Text
  status             MetaAdminApprovalStatus @default(PENDING)
  requestedById      String
  approvedById       String?
  rejectedById       String?
  requestedAt        DateTime                @default(now())
  expiresAt          DateTime
  reviewedAt         DateTime?
  executionStartedAt DateTime?
  executedAt         DateTime?
  failureData        Json?
  version            Int                     @default(1)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  requestedBy AdminUser  @relation("MetaAdminApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  AdminUser? @relation("MetaAdminApprovalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  AdminUser? @relation("MetaAdminApprovalRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  audits      MetaAdminAudit[]
  socialWebhookReplayReceipts MetaSocialWebhookReceipt[] @relation("MetaSocialWebhookReplayApproval")

  @@index([status, expiresAt])
  @@index([actionKey, status])
  @@index([resourceType, resourceId])
  @@index([requestedById, requestedAt])
}

model MetaAdminAudit {
  id            String                @id @default(cuid())
  actorId       String
  actionKey     String
  risk          MetaAdminActionRisk
  resourceType  String
  resourceId    String?
  approvalId    String?
  outcome       MetaAdminAuditOutcome
  beforeData    Json?
  afterData     Json?
  reason        String?               @db.Text
  requestId     String?
  traceId       String?
  ipHash        String?
  userAgentHash String?
  errorData     Json?
  createdAt     DateTime              @default(now())

  actor    AdminUser          @relation("MetaAdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  approval MetaAdminApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([actionKey, createdAt])
  @@index([resourceType, resourceId])
  @@index([approvalId])
  @@index([outcome, createdAt])
}

enum MetaIncidentType {
  CATALOG_DIAGNOSTIC
  CATALOG_BATCH_STUCK
  CATALOG_FAILURE_SPIKE
  TOKEN_INVALID
  GRAPH_VERSION_EXPIRING
  CAPI_FAILURE_SPIKE
  PURCHASE_SILENCE
  WEBHOOK_SILENCE
  QUEUE_BACKLOG
  MASS_DELETE_CANDIDATE
  PRODUCT_SET_EMPTY
  PRODUCT_SET_BROKEN
  INSTAGRAM_PERMISSION_FAILURE
  INSTAGRAM_WEBHOOK_FAILURE
  INSTAGRAM_REPLY_FAILURE
}

enum MetaIncidentSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum MetaIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model MetaIncident {
  id               String               @id @default(cuid())
  incidentType     MetaIncidentType
  severity         MetaIncidentSeverity
  status           MetaIncidentStatus   @default(OPEN)
  dedupeKey        String               @unique
  resourceType     String
  resourceId       String?
  summary          String
  details          Json?
  correlationId    String?
  runbookUrl       String?
  occurrenceCount  Int                  @default(1)
  firstSeenAt      DateTime             @default(now())
  lastSeenAt       DateTime             @default(now())
  cooldownUntil    DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  acknowledgedBy AdminUser? @relation("MetaIncidentAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     AdminUser? @relation("MetaIncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, severity, lastSeenAt])
  @@index([incidentType, status])
  @@index([resourceType, resourceId])
  @@index([correlationId])
}

model MetaApiVersionPolicy {
  id                 String                      @id @default(cuid())
  graphApiVersion    String                      @unique
  releaseDate        DateTime?
  expirationDate     DateTime?
  warningDate        DateTime?
  blockDate          DateTime?
  reviewBy           DateTime?
  latestOfficial     Boolean                     @default(false)
  minimumSupported   Boolean                     @default(false)
  sdkVersion         String?
  regressionStatus   MetaVersionRegressionStatus @default(PENDING)
  regressionEvidence Json?
  sourceUrl          String?
  lastVerifiedAt     DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([latestOfficial])
  @@index([regressionStatus])
  @@index([expirationDate])
  @@index([reviewBy])
}

// ==========================================
// Meta Instagram Messaging / Social CRM
// ==========================================

enum MetaInstagramWebhookStatus {
  RECEIVED
  VERIFIED
  QUEUED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum MetaInstagramConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SPAM
  ARCHIVED
}

enum MetaInstagramMessageDirection {
  INBOUND
  OUTBOUND
}

enum MetaInstagramMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STORY_REPLY
  COMMENT_PRIVATE_REPLY
  POSTBACK
  UNKNOWN
}

enum MetaInstagramMessageStatus {
  RECEIVED
  QUEUED
  PROCESSED
  SENT
  FAILED
  BLOCKED
}

enum MetaInstagramAttachmentStatus {
  PENDING
  READY
  REJECTED
  FAILED
}

enum MetaInstagramConversationKind {
  DIRECT
  COMMENT_THREAD
  STORY_THREAD
  UNKNOWN
}

enum MetaInstagramProviderDeliveryStatus {
  NOT_APPLICABLE
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN_OUTCOME
}

enum MetaInstagramReconciliationStatus {
  NOT_REQUIRED
  REQUIRED
  IN_PROGRESS
  RESOLVED_SENT
  RESOLVED_FAILED
}

enum MetaInstagramPrivateReplyStatus {
  RESERVED
  SENDING
  SENT
  BLOCKED
  FAILED_DEFINITIVE
  UNKNOWN_OUTCOME
}

enum MetaInstagramAttachmentDecision {
  PENDING
  ALLOWED
  QUARANTINED
  REJECTED
  FAILED
}

enum MetaInstagramLinkType {
  CUSTOMER
  LEAD
  PRODUCT
  ORDER
}

enum MetaInstagramReplyEligibility {
  ELIGIBLE
  WINDOW_EXPIRED
  PERMISSION_MISSING
  ACCOUNT_MISMATCH
  UNSUPPORTED
  CONVERSATION_CLOSED
  PRIVATE_REPLY_ALREADY_SENT
}

model MetaInstagramWebhookReceipt {
  id              String                         @id @default(cuid())
  eventKey        String                         @unique
  eventType       String
  objectType      String
  accountId       String?
  senderId        String?
  conversationKey String?
  platformMessageId String?
  signatureOk     Boolean
  payloadDigest   String
  normalizedEvent Json
  correlationId   String
  status          MetaInstagramWebhookStatus     @default(RECEIVED)
  attemptCount    Int                            @default(0)
  receivedAt      DateTime                       @default(now())
  verifiedAt      DateTime?
  queuedAt        DateTime?
  processingAt    DateTime?
  processedAt     DateTime?
  retentionUntil  DateTime
  errorData       Json?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([status, receivedAt])
  @@index([accountId, receivedAt])
  @@index([senderId, receivedAt])
  @@index([platformMessageId])
  @@index([correlationId])
  @@index([retentionUntil])
}

model MetaInstagramParticipant {
  id                         String                  @id @default(cuid())
  environment                MetaPlatformEnvironment
  connectionKey              String
  accountIdentityReferenceId String
  providerParticipantId      String
  username                   String?
  displayName                String?
  avatarUrl                  String?
  profileDigest              String?
  firstSeenAt                DateTime                @default(now())
  lastSeenAt                 DateTime                @default(now())
  lastVerifiedAt             DateTime?
  profileFetchedAt           DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  accountIdentity MetaExternalReference @relation("MetaInstagramParticipantAccountIdentity", fields: [accountIdentityReferenceId], references: [id], onDelete: Restrict)
  conversations   MetaConversation[]

  @@unique([environment, connectionKey, accountIdentityReferenceId, providerParticipantId], map: "MetaInstagramParticipant_scope_provider_key")
  @@index([accountIdentityReferenceId, lastSeenAt], map: "MetaInstagramParticipant_account_seen_idx")
}

model MetaConversation {
  id                            String                           @id @default(cuid())
  platformId                    String
  environment                   MetaPlatformEnvironment?
  connectionKey                 String?
  accountIdentityReferenceId    String?
  participantIdentityId         String?
  providerConversationKey       String?
  conversationKind              MetaInstagramConversationKind   @default(UNKNOWN)
  accountId                     String
  participantId                 String
  participantUsername           String?
  participantName               String?
  participantAvatarUrl          String?
  assignedToId                  String?
  status                        MetaInstagramConversationStatus @default(OPEN)
  tags                          String[]                         @default([])
  subject                       String?
  lastMessageAt                 DateTime?
  lastActivityAt                DateTime?
  lastActivityProviderMessageId String?
  lastActivityMessageId         String?
  lastInboundAt                 DateTime?
  replyWindowOpenedAt           DateTime?
  replyWindowExpiresAt          DateTime?
  replyWindowSourceMessageId    String?
  orderingVersion               Int                              @default(0)
  privateReplySentAt            DateTime?
  policyData                    Json?
  correlationId                 String?
  retentionUntil                DateTime
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime                         @updatedAt
  accountIdentity               MetaExternalReference?          @relation("MetaConversationAccountIdentity", fields: [accountIdentityReferenceId], references: [id], onDelete: SetNull)
  participantIdentity           MetaInstagramParticipant?       @relation(fields: [participantIdentityId], references: [id], onDelete: SetNull)
  messages                      MetaMessage[]
  links                         MetaConversationLink[]
  replyAttempts                 MetaInstagramReplyAttempt[]
  privateReplyReservations      MetaInstagramPrivateReplyReservation[]

  @@unique([environment, connectionKey, accountIdentityReferenceId, providerConversationKey], map: "MetaConversation_scope_provider_key")
  @@index([platformId], map: "MetaConversation_legacy_platform_idx")
  @@index([environment, connectionKey, accountIdentityReferenceId, status, lastActivityAt], map: "MetaConversation_scope_activity_idx")
  @@index([accountId, status, lastMessageAt])
  @@index([participantId])
  @@index([participantIdentityId], map: "MetaConversation_participant_identity_idx")
  @@index([assignedToId, status])
  @@index([lastInboundAt])
  @@index([retentionUntil])
  @@index([correlationId])
}

model MetaMessage {
  id                         String                              @id @default(cuid())
  platformId                 String
  environment                MetaPlatformEnvironment?
  connectionKey              String?
  accountIdentityReferenceId String?
  providerMessageId          String?
  localMessageKey            String?                             @unique
  outboundIdempotencyKey     String?
  conversationId             String
  direction                  MetaInstagramMessageDirection
  messageType                MetaInstagramMessageType
  status                     MetaInstagramMessageStatus          @default(RECEIVED)
  providerStatus             MetaInstagramProviderDeliveryStatus @default(NOT_APPLICABLE)
  text                       String?                              @db.Text
  replyToMessageId           String?
  replyToProviderMessageId   String?
  replyToMessageRecordId     String?
  storyMediaId               String?
  commentId                  String?
  postId                     String?
  payloadDigest              String?
  digestMismatchCount        Int                                 @default(0)
  lastDigestMismatchAt       DateTime?
  providerOccurredAt         DateTime?
  receivedAt                 DateTime                             @default(now())
  sentAt                     DateTime
  deliveredAt                DateTime?
  readAt                     DateTime?
  failedAt                   DateTime?
  privateReplyExpiresAt      DateTime?
  correlationId              String?
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt
  accountIdentity            MetaExternalReference?              @relation("MetaMessageAccountIdentity", fields: [accountIdentityReferenceId], references: [id], onDelete: SetNull)
  conversation               MetaConversation                    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyToMessageRecord       MetaMessage?                        @relation("MetaMessageReplyChain", fields: [replyToMessageRecordId], references: [id], onDelete: SetNull)
  replies                    MetaMessage[]                       @relation("MetaMessageReplyChain")
  attachments                MetaMessageAttachment[]
  replyAttempts              MetaInstagramReplyAttempt[]
  webhookReceipts            MetaSocialWebhookReceipt[]          @relation("MetaSocialWebhookInstagramMessage")
  privateReplyReservations   MetaInstagramPrivateReplyReservation[]

  @@unique([environment, connectionKey, accountIdentityReferenceId, providerMessageId], map: "MetaMessage_scope_provider_key")
  @@unique([environment, connectionKey, accountIdentityReferenceId, outboundIdempotencyKey], map: "MetaMessage_scope_outbound_idempotency_key")
  @@index([platformId], map: "MetaMessage_legacy_platform_idx")
  @@index([conversationId, providerOccurredAt, providerMessageId], map: "MetaMessage_conversation_order_idx")
  @@index([conversationId, sentAt])
  @@index([direction, status, sentAt])
  @@index([providerStatus, sentAt], map: "MetaMessage_provider_status_idx")
  @@index([commentId])
  @@index([postId])
  @@index([replyToMessageRecordId], map: "MetaMessage_reply_record_idx")
  @@index([correlationId])
}

model MetaMessageAttachment {
  id                     String                            @id @default(cuid())
  messageId              String
  externalId             String?
  type                   MetaInstagramMessageType
  status                 MetaInstagramAttachmentStatus    @default(PENDING)
  mimeType               String?
  fileName               String?
  fileSize               Int?
  sourceUrl              String?
  sourceUrlDigest        String?
  sourceUrlExpiresAt     DateTime?
  contentDigest          String?
  validationJobReference String?
  quarantinedAt          DateTime?
  storageKey             String?
  storageUrl             String?
  thumbnailUrl           String?
  failureCode            String?
  metadata               Json?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  message                MetaMessage                       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  policyDecision         MetaInstagramAttachmentPolicyDecision?

  @@unique([messageId, externalId])
  @@index([messageId, status])
  @@index([type, status])
  @@index([validationJobReference], map: "MetaMessageAttachment_validation_job_idx")
}

model MetaInstagramAttachmentPolicyDecision {
  id               String                          @id @default(cuid())
  attachmentId     String                          @unique
  decision         MetaInstagramAttachmentDecision @default(PENDING)
  reasonCode       String?
  validatorVersion String?
  contentDigest    String?
  validationJobRef String?
  decidedAt        DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  attachment       MetaMessageAttachment           @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([decision, decidedAt], map: "MetaInstagramAttachmentDecision_status_idx")
  @@index([validationJobRef], map: "MetaInstagramAttachmentDecision_job_idx")
}

model MetaConversationLink {
  id                 String                    @id @default(cuid())
  conversationId     String
  linkType           MetaInstagramLinkType
  targetId           String
  verificationMethod String
  evidence           Json?
  linkedById         String
  linkedAt           DateTime                  @default(now())
  unlinkedAt         DateTime?
  conversation       MetaConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, linkType, targetId])
  @@index([linkType, targetId])
  @@index([conversationId, linkedAt])
}

model MetaInstagramReplyAttempt {
  id                         String                              @id @default(cuid())
  idempotencyKey             String
  environment                MetaPlatformEnvironment?
  connectionKey              String?
  accountIdentityReferenceId String?
  conversationId             String
  sourceMessageId            String?
  actorId                    String
  mode                       String
  eligibility                MetaInstagramReplyEligibility
  status                     MetaInstagramMessageStatus
  providerStatus             MetaInstagramProviderDeliveryStatus @default(PENDING)
  reconciliationStatus       MetaInstagramReconciliationStatus    @default(NOT_REQUIRED)
  textHash                   String
  providerMessageId          String?
  providerResponseDigest     String?
  payloadHash                String
  localMessageKey            String?
  sourceCommentId            String?
  sourcePostId               String?
  correlationId              String
  failureCode                String?
  failureCategory            String?
  failureSummary             String?                             @db.Text
  failureData                Json?
  requestedAt                DateTime                            @default(now())
  queuedAt                   DateTime?
  sendingAt                  DateTime?
  attemptedAt                DateTime                            @default(now())
  completedAt                DateTime?
  reconciledAt               DateTime?
  accountIdentity            MetaExternalReference?             @relation("MetaInstagramReplyAttemptAccountIdentity", fields: [accountIdentityReferenceId], references: [id], onDelete: SetNull)
  conversation               MetaConversation                    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage              MetaMessage?                        @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  privateReplyReservation    MetaInstagramPrivateReplyReservation?

  @@unique([environment, connectionKey, accountIdentityReferenceId, idempotencyKey], map: "MetaInstagramReplyAttempt_scope_idempotency_key")
  @@unique([environment, connectionKey, accountIdentityReferenceId, providerMessageId], map: "MetaInstagramReplyAttempt_scope_provider_message_key")
  @@index([idempotencyKey], map: "MetaInstagramReplyAttempt_legacy_idempotency_idx")
  @@index([conversationId, attemptedAt])
  @@index([actorId, attemptedAt])
  @@index([status, attemptedAt])
  @@index([providerStatus, reconciliationStatus, attemptedAt], map: "MetaInstagramReplyAttempt_reconcile_idx")
  @@index([correlationId])
}

model MetaInstagramPrivateReplyReservation {
  id                         String                           @id @default(cuid())
  environment                MetaPlatformEnvironment
  connectionKey              String
  accountIdentityReferenceId String
  sourceCommentId            String
  sourceMessageId            String
  conversationId             String
  replyAttemptId             String?                          @unique
  status                     MetaInstagramPrivateReplyStatus @default(RESERVED)
  reservedAt                 DateTime                         @default(now())
  expiresAt                  DateTime
  sentAt                     DateTime?
  providerMessageId          String?
  failureCode                String?
  failureSummary             String?                          @db.Text
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  accountIdentity            MetaExternalReference           @relation("MetaInstagramPrivateReplyAccountIdentity", fields: [accountIdentityReferenceId], references: [id], onDelete: Restrict)
  sourceMessage              MetaMessage                      @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  conversation               MetaConversation                 @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  replyAttempt               MetaInstagramReplyAttempt?       @relation(fields: [replyAttemptId], references: [id], onDelete: SetNull)

  @@unique([environment, connectionKey, accountIdentityReferenceId, sourceCommentId], map: "MetaInstagramPrivateReply_scope_comment_key")
  @@index([status, expiresAt], map: "MetaInstagramPrivateReply_status_expiry_idx")
  @@index([conversationId, reservedAt], map: "MetaInstagramPrivateReply_conversation_idx")
}
