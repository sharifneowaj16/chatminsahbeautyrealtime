  @@index([adsetId])
  @@index([campaignId])
  @@index([status, receivedAt])
  @@index([retrievalStatus, receivedAt])
  @@index([assignedToId, status])
  @@index([normalizedPhoneHash])
  @@index([normalizedEmailHash])
  @@index([phoneFingerprint])
  @@index([emailFingerprint])
  @@index([environment, connectionKey, receivedAt], map: "MetaLead_scope_received_idx")
  @@index([pageIdentityReferenceId], map: "MetaLead_page_identity_idx")
  @@index([formIdentityReferenceId], map: "MetaLead_form_identity_idx")
  @@index([convertedOrderId])
  @@index([retentionUntil])
