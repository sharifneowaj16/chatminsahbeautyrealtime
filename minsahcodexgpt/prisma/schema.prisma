model FbOutboxMessage {
  id              String                @id
  pageId          String
  customerPsid    String
  agentId         String
  clientMessageId String?               @unique
  text            String                @db.Text
  attachmentUrl   String?
  attachmentType  FbAttachmentType?
  conversationId  String?
  localMessageId  String?
  fbMessageId     String?               @unique
  state           FbOutboxState         @default(PENDING)
  attempts        Int                   @default(0)
  lastError       String?               @db.Text
  lastAttemptAt   DateTime?
  queuedAt        DateTime              @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  statusEvents    FbOutboxStatusEvent[]

  @@index([customerPsid, queuedAt])
  @@index([state, queuedAt])
  @@index([pageId, customerPsid])
