// ==========================================
// Meta CAPI Transactional Outbox
// ==========================================

enum MetaEventOutboxStatus {
  PENDING
  DISPATCHED
  PROCESSING
  SENT
  RETRY_SCHEDULED
  FAILED_PERMANENT
  SUPPRESSED
}

model MetaEventOutbox {
  id              String                @id @default(cuid())
  correlationId   String
  provider        String                @default("META")
  eventName       String
  eventId         String
  sourceType      String
  sourceId        String?
  orderId         String?
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actionSource    String
  eventSourceUrl  String?
  eventTime       DateTime
  payload         Json
  safePayload     Json?
  policyVersion   String
  policyReason    String
  consentState    TrackingConsentState
  consentVersion  String?
  allowAdvancedMatching Boolean @default(false)
  retentionUntil  DateTime
  status          MetaEventOutboxStatus @default(PENDING)
  attempts        Int                   @default(0)
  nextAttemptAt   DateTime?
  leaseToken      String?
  leaseExpiresAt  DateTime?
  dispatchedAt    DateTime?
  processingAt    DateTime?
  sentAt          DateTime?
  response        Json?
  lastError       Json?
  suppressReason  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  statusEvents    MetaEventOutboxStatusEvent[]

  @@unique([provider, eventName, eventId])
  @@index([correlationId])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([orderId])
  @@index([sourceType, sourceId])
  @@index([retentionUntil])
  @@index([policyVersion, policyReason])
  @@index([createdAt])
}

model MetaEventOutboxStatusEvent {
  id         String                @id @default(cuid())
  outboxId   String
  outbox     MetaEventOutbox       @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  status     MetaEventOutboxStatus
  attempt    Int                   @default(0)
  note       String?
  safeDetails Json?
  createdAt  DateTime              @default(now())

  @@index([outboxId, createdAt])
  @@index([status, createdAt])
}

// ==========================================
// Meta Durable Jobs / Queue Audit
// ==========================================

enum MetaJobStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

model MetaJobAudit {
  id               String        @id @default(cuid())
  queueName        String
  jobName          String
  externalJobId    String?
  idempotencyKey   String        @unique
  correlationId    String?
  status           MetaJobStatus @default(QUEUED)
  attempts         Int           @default(0)
  maxAttempts      Int           @default(5)
  progress         Int?
  sourceId         String?
  payload          Json
  lastError        Json?
  rateLimitState   Json?
  replayOfId       String?
  replayCount      Int           @default(0)
  requestedBy      String?
  nextRunAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  lastHeartbeatAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([queueName, status])
  @@index([sourceId])
  @@index([replayOfId])
  @@index([nextRunAt])
  @@index([correlationId])
}

// ==========================================
// Privacy / Consent / Data Governance
// ==========================================

enum TrackingConsentState {
  UNKNOWN
  GRANTED
  DENIED
  WITHDRAWN
}

enum DataDeletionRequestStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  COMPLETED
  FAILED
}

model TrackingConsentRecord {
  id          String               @id @default(cuid())
  userId      String?
  visitorId   String?
  state       TrackingConsentState
  version     String
  source      String
  policyVersion String
  recordedAt  DateTime             @default(now())
  withdrawnAt DateTime?
  retentionUntil DateTime

  @@index([userId, recordedAt])
  @@index([visitorId, recordedAt])
  @@index([state, recordedAt])
  @@index([retentionUntil])
}

model DataDeletionRequest {
  id               String                    @id @default(cuid())
  userId           String?
  externalRef      String?
  source           String
  confirmationCode String                    @unique
  status           DataDeletionRequestStatus @default(RECEIVED)
  policyVersion    String
  requestedAt      DateTime                  @default(now())
  completedAt      DateTime?
  error            Json?
  retentionUntil   DateTime
  updatedAt        DateTime                  @updatedAt

  @@index([userId, requestedAt])
  @@index([externalRef])
  @@index([status, requestedAt])
  @@index([retentionUntil])
}

model PrivacyAuditLog {
  id             String   @id @default(cuid())
  action         String
  actorType      String
  actorId        String?
  subjectUserId  String?
  requestId      String?
  policyVersion  String
  safeDetails    Json?
  retentionUntil DateTime
  createdAt      DateTime @default(now())

  @@index([action, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([requestId])
  @@index([retentionUntil])
}

model TrackingSuppression {
  id             String   @id @default(cuid())
  identityHash   String   @unique
  reason         String
  source         String
  policyVersion  String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  expiresAt      DateTime?

  @@index([active, createdAt])
  @@index([expiresAt])
}

// ==========================================
// Tracking / CAPI Failure Log
