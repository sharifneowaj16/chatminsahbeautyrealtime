  assignedToId          String?
  assignmentRuleId      String?
  assignmentReason      String?
  receivedAt            DateTime
  sourceCreatedAt       DateTime?
  freshnessSeconds      Int?
  fetchedAt             DateTime?
  assignedAt            DateTime?
  contactedAt           DateTime?
  qualifiedAt           DateTime?
  convertedAt           DateTime?
  lostAt                DateTime?
  convertedOrderId      String?
  lastError             Json?
  retentionUntil        DateTime
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  assignedTo            AdminUser?              @relation("MetaLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedOrder        Order?                  @relation("MetaLeadConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  pageIdentityReference MetaExternalReference?  @relation("MetaLeadPageIdentity", fields: [pageIdentityReferenceId], references: [id], onDelete: SetNull)
  formIdentityReference MetaExternalReference?  @relation("MetaLeadFormIdentity", fields: [formIdentityReferenceId], references: [id], onDelete: SetNull)
  duplicates            MetaLeadDuplicate[]
