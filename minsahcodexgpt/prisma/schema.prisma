// ==========================================
// First-Party Marketing Attribution (Meta v6 Phase 11)
// ==========================================

enum MarketingAttributionConversionType {
  SESSION
  LEAD
  ORDER
}

enum MarketingAttributionSourceModel {
  FIRST_PARTY
  META_REPORTED
}

model MarketingAttribution {
  id               String   @id @default(cuid())
  attributionKey   String   @unique
  sessionId        String?
  visitorId        String?
  customerId       String?
  orderId          String?
  leadId           String?

  fbclid           String?
  fbc              String?
  fbp              String?

  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  landingPage      String?

  firstTouch       Json?
  lastTouch        Json?
  checkoutSnapshot Json?
  dataQuality      Json?
  correctionAudit  Json?

  consentState     String?
  conversionType   MarketingAttributionConversionType @default(SESSION)
  sourceModel      MarketingAttributionSourceModel     @default(FIRST_PARTY)
  conversionValue  Decimal? @db.Decimal(12, 2)
  currency         String?
  firstTouchedAt   DateTime?
  lastTouchedAt    DateTime?
  convertedAt      DateTime?
  captureCount     Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([leadId])
  @@index([sessionId])
  @@index([visitorId])
  @@index([customerId])
  @@index([utmSource, utmMedium, utmCampaign])
  @@index([conversionType, convertedAt])
  @@index([sourceModel, createdAt])
}

model MarketingAttributionDailyAggregate {
  id               String   @id @default(cuid())
  aggregateDate    DateTime @db.Date
  sourceModel      MarketingAttributionSourceModel @default(FIRST_PARTY)
  utmSource        String   @default("direct")
  utmMedium        String   @default("none")
  utmCampaign      String   @default("unattributed")
  sessions         Int      @default(0)
  leads            Int      @default(0)
  orders           Int      @default(0)
  newCustomerOrders Int     @default(0)
  returningCustomerOrders Int @default(0)
  revenue          Decimal  @default(0) @db.Decimal(14, 2)
  attributedOrders Int      @default(0)
  missingClickIds  Int      @default(0)
  consentDenied    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([aggregateDate, sourceModel, utmSource, utmMedium, utmCampaign])
  @@index([aggregateDate, sourceModel])
  @@index([utmCampaign, aggregateDate])
}

