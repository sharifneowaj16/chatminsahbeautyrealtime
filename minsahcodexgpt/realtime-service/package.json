{
  "name": "minsah-realtime-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bash scripts/build.sh",
    "typecheck": "bash scripts/typecheck.sh",
    "start": "REALTIME_RUNTIME_FLAVOR=bridge node dist/realtime-service/src/index.js",
    "start:legacy": "REALTIME_RUNTIME_FLAVOR=legacy REALTIME_FACEBOOK_MODE=legacy REALTIME_FACEBOOK_LEGACY_ROLLBACK_ENABLED=true tsx src/index.ts",
    "prisma:generate": "npx prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "^16.4.5",
    "express": "4.22.2",
    "ioredis": "^5.8.1",
    "minio": "^8.0.7",
    "pg": "^8.13.3",
    "ws": "8.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.32",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "prisma": "7.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
