{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/app.ts",
    "src/config.ts",
    "src/routes/bridge-webhook.router.ts",
    "src/realtime/event-store.ts",
    "src/realtime/event-window.ts",
    "src/realtime/internal-auth.ts",
    "src/realtime/pubsub.ts",
    "src/realtime/ws-auth.ts",
    "src/realtime/ws-server.ts",
    "src/facebook/types.ts",
    "../packages/meta-realtime-contract/src/**/*",
    "src/facebook/cutover.ts",
    "src/realtime/main-app-facebook-handoff.ts",
    "../packages/meta-facebook-cutover-contract/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
