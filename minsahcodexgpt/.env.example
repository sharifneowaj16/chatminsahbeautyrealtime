# Minsah Beauty environment template
# Copy this file to .env.local for local development or configure the same keys
# in the deployment provider. Never commit real credentials.

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://replace-with-production-domain.example
NEXT_PUBLIC_SITE_URL=https://replace-with-production-domain.example
NEXTAUTH_URL=https://replace-with-production-domain.example
APP_URL=https://replace-with-production-domain.example
SITE_URL=https://replace-with-production-domain.example
NEXT_PUBLIC_API_URL=https://replace-with-production-domain.example/api
ALLOWED_ORIGINS=https://replace-with-production-domain.example
LOG_LEVEL=info

# Node services
NEXT_PUBLIC_REALTIME_WS_URL=wss://replace-with-realtime-domain.example/ws
REALTIME_SERVICE_INTERNAL_URL=http://realtime-service:3001
DISABLE_EMBEDDED_WORKERS=false

# -----------------------------------------------------------------------------
# Authentication and database
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=replace-with-random-nextauth-secret-at-least-32-characters
JWT_SECRET=replace-with-different-jwt-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-refresh-secret-at-least-32-characters
PASSWORD_RESET_TOKEN_SECRET=replace-with-password-reset-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

DATABASE_URL=postgresql://replace-with-production-db-user:replace-with-password@replace-with-db-host:5432/replace-with-db-name
DIRECT_URL=postgresql://replace-with-production-db-user:replace-with-password@replace-with-db-host:5432/replace-with-db-name
# Use redis:// for Redis reachable only on a protected private service network.
# Use rediss:// only when the deployed Redis endpoint actually enables TLS.
REDIS_URL=redis://replace-with-private-redis-host:6379

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Password reset / email
PASSWORD_RESET_OTP_WEBHOOK_URL=
PASSWORD_RESET_OTP_WEBHOOK_SECRET=
EMAIL_FROM=
SUPPORT_EMAIL=
PRIVACY_CONTACT_EMAIL=
DATA_DELETION_EMAIL=

# -----------------------------------------------------------------------------
# Object storage / media uploads
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=replace-with-production-object-storage-host
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-with-production-minio-access-key
MINIO_SECRET_KEY=replace-with-production-minio-secret-key
MINIO_BUCKET_NAME=minsah-beauty
NEXT_PUBLIC_MINIO_PUBLIC_URL=https://replace-with-production-media-cdn.example
META_MEDIA_CLAMAV_HOST=clamav
META_MEDIA_CLAMAV_PORT=3310
META_MEDIA_CLAMAV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Search / Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=https://replace-with-elasticsearch-host.example
ELASTIC_PASSWORD=
ELASTICSEARCH_VERSION=9
SEARCH_ADMIN_COOKIE=

# -----------------------------------------------------------------------------
# Payment gateways
# -----------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret-at-least-32-characters
META_BROWSER_PURCHASE_TOKEN_SECRET=replace-with-browser-purchase-secret-at-least-32-characters

BKASH_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_SANDBOX=true
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# -----------------------------------------------------------------------------
# Courier integrations
# -----------------------------------------------------------------------------
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
