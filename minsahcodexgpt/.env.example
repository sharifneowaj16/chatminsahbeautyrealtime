PATHAO_WEBHOOK_CALLBACK_URL=https://replace-with-production-domain.example/api/webhooks/pathao
PATHAO_WEBHOOK_SECRET=
PATHAO_WEBHOOK_INTEGRATION_SECRET=

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_DELIVERY_QUOTE_URL=
STEADFAST_WEBHOOK_SECRET=
STEADFAST_WEBHOOK_CUSTOMER_KEY=
STEADFAST_WEBHOOK_AUTH_TOKEN=
STEADFAST_WEBHOOK_AUTHORIZATION=

# -----------------------------------------------------------------------------
# General cron and internal service security
# -----------------------------------------------------------------------------
CRON_SECRET=replace-with-random-cron-secret-at-least-32-characters
INTERNAL_CRON_SECRET=replace-with-internal-cron-secret-at-least-32-characters
WS_AUTH_SECRET=replace-with-websocket-secret-at-least-32-characters
REPLY_API_SECRET=replace-with-reply-api-secret-at-least-32-characters

# -----------------------------------------------------------------------------
# Meta Pixel / CAPI
# -----------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
# Required after catalog export verification: sku or database_id.
# Server and browser values must match when the Meta catalog is enabled.
META_CATALOG_ID_SOURCE=sku
NEXT_PUBLIC_META_CATALOG_ID_SOURCE=sku

# MetaPlatform Phase 30 — catalog/commerce cutover and safety
META_PLATFORM_CATALOG_SHADOW=false
META_PLATFORM_CATALOG_READS=false
META_PLATFORM_CATALOG_WRITES=false
META_PLATFORM_CATALOG_LEGACY_DISABLED=false
META_PLATFORM_CATALOG_KILL_SWITCH=false
META_PLATFORM_CATALOG_TEST_CATALOG_ID=
META_PLATFORM_CATALOG_READ_CACHE_FRESH_MS=60000
META_PLATFORM_CATALOG_READ_CACHE_STALE_MS=21600000
META_PLATFORM_CATALOG_ITEM_RETRY_MAX_ATTEMPTS=3
META_PLATFORM_CATALOG_DELETE_MAX_COUNT=100
META_PLATFORM_CATALOG_DELETE_MAX_RATIO=0.25
META_PLATFORM_CATALOG_MASS_DELETE_OVERRIDE=false
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_FB_PIXEL_ENABLED=false
META_PIXEL_ID=
META_DATASET_ID=
# Dedicated System User token for Marketing API / Business SDK. The MetaPlatform credential boundary never falls back across roles.
META_BUSINESS_ACCESS_TOKEN=
META_CAPI_ACCESS_TOKEN=
# Required for /debug_token app-association verification.
META_APP_ID=
# Optional external secret-manager reference shown in admin health; never put the token value here.
META_ACCESS_TOKEN_SECRET_REF=
# Phase 22 role-isolated secret references. env:VAR is supported by the built-in provider.
META_APP_SECRET_REF=env:META_APP_SECRET
META_BUSINESS_ACCESS_TOKEN_SECRET_REF=env:META_BUSINESS_ACCESS_TOKEN
META_CAPI_ACCESS_TOKEN_SECRET_REF=env:META_CAPI_ACCESS_TOKEN
META_PAGE_ACCESS_TOKEN_SECRET_REF=env:META_PAGE_ACCESS_TOKEN
META_INSTAGRAM_ACCESS_TOKEN_SECRET_REF=env:META_INSTAGRAM_ACCESS_TOKEN
META_APP_GRANTED_PERMISSIONS=
META_BUSINESS_GRANTED_PERMISSIONS=ads_management,ads_read,business_management,catalog_management
META_CAPI_GRANTED_PERMISSIONS=
META_PAGE_GRANTED_PERMISSIONS=leads_retrieval,pages_manage_metadata,pages_messaging,pages_read_engagement
META_INSTAGRAM_GRANTED_PERMISSIONS=instagram_basic,instagram_manage_messages,pages_read_engagement
META_APP_CREDENTIAL_ROTATED_AT=
META_BUSINESS_CREDENTIAL_ROTATED_AT=
META_CAPI_CREDENTIAL_ROTATED_AT=
META_PAGE_CREDENTIAL_ROTATED_AT=
META_INSTAGRAM_CREDENTIAL_ROTATED_AT=
META_APP_CREDENTIAL_EXPIRES_AT=
META_BUSINESS_CREDENTIAL_EXPIRES_AT=
META_CAPI_CREDENTIAL_EXPIRES_AT=
META_PAGE_CREDENTIAL_EXPIRES_AT=
META_INSTAGRAM_CREDENTIAL_EXPIRES_AT=
META_BUSINESS_DATA_ACCESS_EXPIRES_AT=
META_CAPI_DATA_ACCESS_EXPIRES_AT=
META_PAGE_DATA_ACCESS_EXPIRES_AT=
META_INSTAGRAM_DATA_ACCESS_EXPIRES_AT=
# Canonical MetaPlatform scope used by durable receipt and operation dedupe.
# Allowed: DEVELOPMENT, STAGING, PRODUCTION. Set STAGING explicitly when NODE_ENV=production.
META_PLATFORM_ENVIRONMENT=DEVELOPMENT
META_CONNECTION_NAME=primary
META_REQUIRED_PERMISSIONS=ads_management,ads_read,business_management,catalog_management,pages_manage_metadata,pages_read_engagement,leads_retrieval,instagram_basic,instagram_manage_messages
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
# Server-side safety limits for approval-based Marketing API mutations.
META_ADS_MAX_DAILY_BUDGET_BDT=50000
META_ADS_MAX_LIFETIME_BUDGET_BDT=500000
META_ADS_MAX_BID_BDT=10000
META_ADS_MAX_BUDGET_INCREASE_PERCENT=25
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACTOR_ID=
# Dedicated token for Instagram Messaging/profile/reply operations. Keep server-only.
META_INSTAGRAM_ACCESS_TOKEN=
# Optional provider path override for controlled API compatibility testing.
META_INSTAGRAM_SEND_PATH=
# Normalized message/attachment retention window (7-730 days).
META_INSTAGRAM_RETENTION_DAYS=180
META_CATALOG_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=replace-with-meta-webhook-verify-token-at-least-32-characters
META_CATALOG_FEED_TOKEN=replace-with-meta-catalog-feed-token-at-least-32-characters
META_BUSINESS_CRON_SECRET=replace-with-meta-business-cron-secret-at-least-32-characters
# v24.0 remains the controlled baseline until the v25 regression checklist is approved.
META_GRAPH_API_VERSION=v24.0
META_CAPI_TIMEOUT_MS=10000
META_CAPI_PARTNER_AGENT=minsahbeauty-meta-platform
# Phase 28 connection reads: keep both false for legacy, enable SHADOW first, then READS for platform cutover.
META_PLATFORM_CONNECTION_SHADOW=false
META_PLATFORM_CONNECTION_READS=false
# Set true only after shadow/runtime evidence and rollback drill prove the legacy health path is no longer needed.
META_PLATFORM_CONNECTION_LEGACY_DISABLED=false
# Phase 28 CAPI writes: test-event -> deterministic canary -> full platform. Selection is stable by event_id.
META_PLATFORM_CAPI_TEST_EVENTS=false
META_PLATFORM_CAPI_CANARY_PERCENT=0
META_PLATFORM_CAPI_WRITES=false
# Set true only after the unified worker path has runtime evidence and the legacy producer is intentionally retired.
META_PLATFORM_CAPI_LEGACY_DISABLED=false

# Phase 29 Ads/creative/insight reads: legacy -> shadow -> platform.
META_PLATFORM_ADS_SHADOW=false
META_PLATFORM_ADS_READS=false
# Approval-governed writes remain legacy-selected until test asset or full platform cutover is explicit.
META_PLATFORM_ADS_TEST_ASSET_ID=
META_PLATFORM_ADS_WRITES=false
META_PLATFORM_ADS_LEGACY_DISABLED=false
META_PLATFORM_ADS_KILL_SWITCH=false
# Emergency global stop for every Phase 29 Ads/Audience write path.
META_PLATFORM_ADS_GLOBAL_KILL_SWITCH=false
# Bounded in-process stale read cache. Stale insight data is never accepted as a successful sync.
META_PLATFORM_ADS_READ_CACHE_FRESH_MS=60000
META_PLATFORM_ADS_READ_CACHE_STALE_MS=21600000

# Phase 29 Custom/Lookalike/Website Audience reads and writes use an independent cutover lane.
META_PLATFORM_AUDIENCES_SHADOW=false
META_PLATFORM_AUDIENCES_READS=false
META_PLATFORM_AUDIENCES_TEST_ASSET_ID=
META_PLATFORM_AUDIENCES_WRITES=false
META_PLATFORM_AUDIENCES_LEGACY_DISABLED=false
META_PLATFORM_AUDIENCES_KILL_SWITCH=false

META_TEST_EVENT_CODE=
FACEBOOK_CONVERSION_API_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v20.0
FACEBOOK_TEST_EVENT_CODE=
FACEBOOK_PAGE_ID=
FB_PAGE_ID=

# -----------------------------------------------------------------------------
# GA4 / Google tags
