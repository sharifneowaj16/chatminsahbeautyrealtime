NEXT_PHASE=

# Meta Lead Ads / CRM (Phase 8)
# 32-byte base64/hex key. Required in production; do not reuse access tokens.
META_LEAD_DATA_KEY=
# Optional comma-separated form ownership allowlist. Empty means configured Page ownership only.
META_LEAD_ALLOWED_FORM_IDS=
META_LEAD_MAX_RETRIEVAL_AGE_SECONDS=7776000
META_LEAD_RESPONSE_SLA_MINUTES=15
META_LEAD_RAW_RETENTION_DAYS=90
META_LEAD_RETENTION_DAYS=365
META_LEAD_WEBHOOK_RETENTION_DAYS=30
# Optional internal notification endpoint; receives masked contact values only.
META_LEAD_NOTIFICATION_WEBHOOK_URL=
# Optional purpose-separated HMAC key for scoped Lead phone/email fingerprints. Falls back to META_LEAD_DATA_KEY.
META_LEAD_FINGERPRINT_KEY=

# -----------------------------------------------------------------------------
# Meta admin operation controls (Phase 31 / Layer 7)
# -----------------------------------------------------------------------------
# Emergency stop for every Layer 7 Meta admin mutation.
META_ADMIN_ACTIONS_KILL_SWITCH=false
# Narrow emergency stops for approval-backed queue controls.
META_ADMIN_REPLAY_KILL_SWITCH=false
META_ADMIN_CANCEL_KILL_SWITCH=false
# Existing platform-wide emergency stop is also honored by Layer 7 controls.
META_PLATFORM_GLOBAL_KILL_SWITCH=false
# Layer 8.2 emergency stop for every social provider write, including queued workers.
META_PLATFORM_SOCIAL_OUTBOUND_KILL_SWITCH=false
# Optional narrower emergency stops. Invalid values fail safe as active.
META_PLATFORM_INSTAGRAM_KILL_SWITCH=false
META_PLATFORM_FACEBOOK_KILL_SWITCH=false

# -----------------------------------------------------------------------------
# Meta social cutover controls (Phase 31 / Layer 8.1)
# -----------------------------------------------------------------------------
# Platform authority stays disabled until the corresponding controlled cutover item passes.
META_PLATFORM_LEADS=false
META_PLATFORM_INSTAGRAM=false
# Legacy Facebook remains available by default until observed cutover and rollback proof complete.
META_PLATFORM_LEGACY_FACEBOOK=true
META_PLATFORM_SOCIAL_REALTIME=false
META_PLATFORM_SOCIAL_WEBHOOKS=false
META_PHASE31_FACEBOOK_INBOX_RUNTIME=LEGACY
# Lead cutover authority: LEGACY | SHADOW | PLATFORM | DOMAIN (alias) | LEGACY_ROLLBACK
META_PHASE31_LEAD_RUNTIME=LEGACY
# Instagram read/write/media authority. SHADOW never performs a second durable processor or provider write.
META_PHASE31_INSTAGRAM_INBOUND_RUNTIME=LEGACY
META_PHASE31_INSTAGRAM_OUTBOUND_RUNTIME=LEGACY
META_PHASE31_INSTAGRAM_MEDIA_RUNTIME=LEGACY
# External side effects are independently fail-closed.
META_PLATFORM_INSTAGRAM_WRITES=false
META_PLATFORM_INSTAGRAM_PRIVATE_REPLY=false
META_PLATFORM_SOCIAL_MEDIA_DOWNLOADS=false
META_PLATFORM_SOCIAL_REPLAY=false
